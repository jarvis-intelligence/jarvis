        <mxCell id="foot" value="If bge-m3 is permanent and you never intend to swap models, this whole gap is theoretical — &quot;do nothing&quot; is a legitimate fourth answer." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;fontSize=12;fontColor=#333333;align=left;spacingLeft=12;" vertex="1" parent="1">
