   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "seed": 100044,
   "updated": 1,
   "boundElements": null,
   "text": "skips: .gitignore'd files \u00b7 > 1 MB \u00b7 generated-file banners \u00b7 lines > 5000 chars\n--semantic-include overrides all three.  A table only ever holds one model+revision.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "skips: .gitignore'd files \u00b7 > 1 MB \u00b7 generated-file banners \u00b7 lines > 5000 chars\n--semantic-include overrides all three.  A table only ever holds one model+revision.",
