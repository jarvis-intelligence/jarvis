  "cards": [
    {
      "dot": "cyan",
      "title": "Read path",
      "items": [
        "9 MCP tools over stdio: documentSymbols → blastRadius",
        "Nav SQL reads immutable index-<sha>.db behind the current pointer",
        "searchCode lazily spawns zoekt-webserver on :6070",
        "semanticSearch fuses LanceDB + Zoekt + symbols via RRF"
      ]
    },
    {
      "dot": "emerald",
      "title": "Write path",
      "items": [
        "index: detect language → SCIP indexer → scip expt-convert",
        "zoekt-git-index builds shards from git blobs (HEAD)",
        "Repo rows + package graph rebuilt in registry.db",
        "Atomic publish: write index-<sha>.db, then os.replace(current)"
      ]
    },
    {
      "dot": "amber",
      "title": "Invariants",
      "items": [
        "Published DBs are never mutated; readers open mode=ro&immutable=1",
        "Zoekt reflects HEAD while SCIP reflects the working tree",
        "Single-tenant by design: PROJECT = BRANCH = \"_\""
      ]
    }
  ]
}
