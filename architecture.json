    { "kind": "region", "label": "Persistent local data", "wraps": ["scip-db", "search-index", "lancedb", "graph-registry"] }
  ],
  "connections": [
    { "id": "request", "from": "mcp-client", "to": "mcp-server", "label": "MCP stdio request", "variant": "emphasis" },
