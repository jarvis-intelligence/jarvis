    { "id": "query-service", "type": "backend", "label": "QueryService", "sublabel": "SCIP navigation", "row": 0, "col": 2 },
    { "id": "scip-reader", "type": "backend", "label": "Index Reader Cache", "sublabel": "read-only SQLite", "row": 0, "col": 3 },
    { "id": "scip-db", "type": "database", "label": "SCIP Index", "sublabel": "published / immutable", "tag": "source of truth", "row": 0, "col": 4, "size": [180, 90] },
