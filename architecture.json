    { "id": "zoekt-http", "from": "search-facade", "to": "zoekt", "label": "HTTP JSON search" },
    { "id": "zoekt-data", "from": "zoekt", "to": "search-index", "label": "read shards" },
    { "id": "blast", "from": "mcp-server", "to": "graph-registry", "label": "blastRadius", "labelDx": 100, "labelDy": 47 },
    { "id": "vectors", "from": "search-facade", "to": "lancedb", "label": "vector query" },
    { "id": "index-source", "from": "indexer", "to": "repository", "label": "read files", "labelDy": 24 },
    { "id": "index-tools", "from": "indexer", "to": "toolchain", "label": "invoke indexers" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Primary query path", "items": ["The MCP server dispatches navigation calls into QueryService", "IndexConnectionCache opens the selected published database read-only", "Queries use the current pointer, so readers never observe an in-place mutation"] },
    { "dot": "orange", "title": "Indexing, publication + boundaries", "items": ["Index CLI detects language from git-tracked files and invokes the matching SCIP toolchain", "Graph and Zoekt work must succeed before the current pointer is swapped", "A watcher can trigger the same foreground indexing workflow", "The MCP client and local toolchain are boundary peers; persistent indexes remain on the local filesystem"] },
    { "dot": "emerald", "title": "Optional capability branches", "items": ["searchCode lazy-starts one local Zoekt webserver and queries its shards over HTTP", "semanticSearch fuses LanceDB vectors with Zoekt and symbol hits using reciprocal rank fusion", "blastRadius reads a rebuilt package dependency graph from the registry database"] }
  ]
